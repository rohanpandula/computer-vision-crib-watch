# Login for the MQTT broker Home Assistant uses
FRIGATE_MQTT_USER=
FRIGATE_MQTT_PASSWORD=

# RTSP address of the crib camera. The stream must carry audio.
# Use the lowest-quality stream the camera offers; only the sound is used.
FRIGATE_CAMERA_URL=rtsp://user:password@camera-address:554/stream

# Optional listen service (docker compose --profile listen up -d)
# LISTEN_NAME is the Bonjour name: crib-audio gives http://crib-audio.local:8766
# Set LISTEN_NAME= (empty) to turn Bonjour off. Set LISTEN_IP if the machine has
# several network addresses and the wrong one is advertised.
#LISTEN_NAME=crib-audio
# LISTEN_PORT=80 drops the port from the address (http://crib-audio.local) if
# nothing else on the machine uses port 80.
#LISTEN_PORT=8766
#LISTEN_IP=
