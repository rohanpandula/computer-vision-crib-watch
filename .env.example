# Home Assistant
HA_URL=http://homeassistant.local:8123
HA_TOKEN=paste-a-long-lived-access-token-here

# The crib camera entity, the child's Huckleberry device id, and its sleep sensor
CAMERA=camera.crib
HUCKLEBERRY_DEVICE_ID=
SLEEP_SENSOR=sensor.baby_sleep

# Optional: the camera's motion sensor. During a sleep, motion triggers an immediate
# check, so wake times are caught within seconds instead of at the next check.
# MOTION_SENSOR=binary_sensor.crib_motion

# Optional: a cry sensor, such as the one from the cry-alert folder. A cry during a sleep
# triggers an immediate check, and if the baby is then seen awake or gone, the sleep ends
# at the time of the cry.
# CRY_SENSOR=binary_sensor.crib_cry

# Optional problem alerts: a push when the camera or model has been failing for
# BLIND_ALERT_MIN minutes, and when Huckleberry calls keep failing. Fill in any of these
# and every one that is filled in gets the message. Only the Home Assistant one has been
# used for real; the others are untested.
# NOTIFY_SERVICE=notify.mobile_app_my_phone     # Home Assistant notify service
# NTFY_TOPIC=                                   # ntfy (NTFY_URL is the server address without the topic, default https://ntfy.sh; NTFY_TOKEN optional)
# PUSHOVER_TOKEN=
# PUSHOVER_USER=
# PUSHBULLET_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# GOTIFY_URL=
# GOTIFY_TOKEN=
# DISCORD_WEBHOOK=
# SLACK_WEBHOOK=
# WEBHOOK_URL=                                  # any URL; receives JSON {"title": ..., "message": ...}

# Optional: port for the frame review page (docker compose --profile review up -d)
# REVIEW_PORT=8765

# Ollama server and a vision-capable model
OLLAMA_URL=http://localhost:11434
MODEL=gemma4:12b-it-qat

# 1 = only record what it would log, 0 = write to Huckleberry
DRY_RUN=1

# Time zone for log timestamps and saved frame names
TZ=UTC

# Optional tuning (defaults shown)
# INTERVAL_S=120
# ASLEEP_CHECKS=3
# WAKE_MIN=10
# MIN_SLEEP_MIN=10
# OFFLINE_END_MIN=60
# BLIND_ALERT_MIN=15
# RETRY_ALERT_TRIES=15
