# Home Assistant
HA_URL=http://homeassistant.local:8123
HA_TOKEN=paste-a-long-lived-access-token-here

# The crib camera entity, the child's Huckleberry device id, and its sleep sensor
CAMERA=camera.crib
HUCKLEBERRY_DEVICE_ID=
SLEEP_SENSOR=sensor.baby_sleep

# Optional: the camera's motion sensor. During a sleep, motion triggers an immediate
# check, so wake times are caught within seconds instead of at the next check.
# MOTION_SENSOR=binary_sensor.crib_motion

# Optional: a cry sensor, such as the one from the cry-alert folder. A cry during a sleep
# triggers an immediate check, and if the baby is then seen awake or gone, the sleep ends
# at the time of the cry.
# CRY_SENSOR=binary_sensor.crib_cry

# Optional: a Home Assistant notify service. Sends a push when the camera or model has
# been failing for BLIND_ALERT_MIN minutes, and when Huckleberry calls keep failing.
# NOTIFY_SERVICE=notify.mobile_app_my_phone

# Ollama server and a vision-capable model
OLLAMA_URL=http://localhost:11434
MODEL=gemma4:12b-it-qat

# 1 = only record what it would log, 0 = write to Huckleberry
DRY_RUN=1

# Time zone for log timestamps and saved frame names
TZ=UTC

# Optional tuning (defaults shown)
# INTERVAL_S=120
# ASLEEP_CHECKS=3
# WAKE_MIN=10
# MIN_SLEEP_MIN=10
# OFFLINE_END_MIN=60
# BLIND_ALERT_MIN=15
# RETRY_ALERT_TRIES=15
